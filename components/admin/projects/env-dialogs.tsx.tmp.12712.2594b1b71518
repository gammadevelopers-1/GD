"use client";

import { useActionState, useRef, useState } from "react";
import {
  Check,
  Eraser,
  Loader2,
  Move,
  Plus,
  Share2,
  Trash2,
  Upload,
  X,
} from "lucide-react";
import type { EnvCandidate, EnvGroupRow, EnvHolder, MainEntryRow } from "@/data/env-workspace";
import { IDLE_FORM, type SimpleFormState } from "@/lib/projects/form-state";
import {
  ENV_GROUP_NAME_MAX,
  type EnvPair,
  isEnvKey,
  parseEnvBlob,
} from "@/lib/projects/env";
import { type Tone, TONE_SOFT } from "@/lib/admin-ui";
import { cn } from "@/lib/utils";
import { Button, buttonVariants } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { PasswordInput } from "@/components/ui/password-input";
import { FormSelect } from "@/components/common/form-select";
import { Modal } from "./modal";
import { useCloseOnSuccess } from "./use-close-on-success";

export type FormAction = (
  state: SimpleFormState,
  formData: FormData,
) => Promise<SimpleFormState>;

function Problem({ state }: { state: SimpleFormState }) {
  if (state.status !== "error" || !state.message) return null;
  return (
    <p role="alert" className="mt-3 text-xs text-red-700">
      {state.message}
    </p>
  );
}

function Footer({
  pending,
  disabled,
  submit,
  onClose,
  tone = "cta",
  icon,
}: {
  pending: boolean;
  disabled?: boolean;
  submit: string;
  onClose: () => void;
  tone?: "cta" | "danger";
  icon?: React.ReactNode;
}) {
  return (
    <div className="mt-5 flex items-center justify-end gap-2">
      <Button type="button" variant="admin-ghost" size="admin" onClick={onClose}>
        Cancel
      </Button>
      <Button
        type="submit"
        variant={tone === "danger" ? "admin-danger" : "admin-cta"}
        size="admin"
        disabled={pending || disabled}
        {...(tone === "cta" ? { "data-button-fill": true } : {})}
      >
        {pending ? <Loader2 className="size-4 animate-spin" /> : icon}
        <span className="button-fill-fx__label">{submit}</span>
      </Button>
    </div>
  );
}

export function VariableDialog({
  scope,
  projectId,
  groupId,
  groups,
  action,
  onClose,
}: {
  scope: "main" | "version";
  projectId: string;
  groupId: string | null;
  groups: EnvGroupRow[];
  action: FormAction;
  onClose: () => void;
}) {
  const [state, formAction, pending] = useActionState(action, IDLE_FORM);
  const [target, setTarget] = useState(groupId ?? groups[0]?.id ?? "");
  const [key, setKey] = useState("");
  const [value, setValue] = useState("");
  useCloseOnSuccess(state, onClose);

  if (!groups.length) {
    return (
      <Modal open title="Add variable" onClose={onClose}>
        <div className="px-5 py-4">
          <p className="text-xs leading-relaxed text-black/60">
            There is no group to put it in yet. Create a group first, then add
            variables to it.
          </p>
          <div className="mt-5 flex justify-end">
            <Button variant="admin-secondary" size="admin" onClick={onClose}>
              Close
            </Button>
          </div>
        </div>
      </Modal>
    );
  }

  return (
    <Modal
      open
      title="Add variable"
      onClose={onClose}
    >
      <form action={formAction} className="px-5 py-4">
        <input type="hidden" name="groupId" value={target} />
        {scope === "main" ? (
          <>
            <input type="hidden" name="projectId" value={projectId} />
            <input
              type="hidden"
              name="rows"
              value={JSON.stringify([{ key: key.trim(), value }])}
            />
          </>
        ) : null}

        <label className="block space-y-1.5">
          <span className="text-xs font-medium text-black/70">Key</span>
          <Input
            name="key"
            variant="admin"
            autoFocus
            required
            value={key}
            onChange={(event) => setKey(event.target.value)}
            placeholder="STRIPE_SECRET_KEY"
            className="h-9 font-mono text-xs"
          />
        </label>

        <label className="mt-3.5 block space-y-1.5">
          <span className="text-xs font-medium text-black/70">Value</span>
          <PasswordInput
            name="value"
            variant="admin"
            revealNoun="value"
            autoComplete="off"
            spellCheck={false}
            value={value}
            onChange={(event) => setValue(event.target.value)}
            placeholder="sk_live_…"
            className="h-9 font-mono text-xs"
          />
        </label>

        {groups.length > 1 ? (
          <div className="mt-3.5 space-y-1.5">
            <span className="text-xs font-medium text-black/70">Group</span>
            <FormSelect
              value={target}
              onValueChange={setTarget}
              ariaLabel="Group"
              triggerClassName="h-9 w-full rounded-xl border border-black/[0.09] bg-white px-3 text-sm"
              options={groups.map((group) => ({
                value: group.id,
                label: group.name,
              }))}
            />
          </div>
        ) : null}

        <Problem state={state} />
        <Footer
          pending={pending}
          submit="Add variable"
          onClose={onClose}
          icon={<Check className="size-4" />}
        />
      </form>
    </Modal>
  );
}

export function EditVariableDialog({
  projectId,
  credentialId,
  variableKey,
  note,
  action,
  onClose,
}: {
  projectId: string;
  credentialId: string;
  variableKey: string;
  note: string | null;
  action: FormAction;
  onClose: () => void;
}) {
  const [state, formAction, pending] = useActionState(action, IDLE_FORM);
  useCloseOnSuccess(state, onClose);

  return (
    <Modal open title="Edit variable" onClose={onClose}>
      <form action={formAction} className="px-5 py-4">
        <input type="hidden" name="projectId" value={projectId} />
        <input type="hidden" name="credentialId" value={credentialId} />

        <label className="block space-y-1.5">
          <span className="text-xs font-medium text-black/70">Key</span>
          <Input
            name="key"
            variant="admin"
            autoFocus
            required
            defaultValue={variableKey}
            className="h-9 font-mono text-xs"
          />
        </label>

        <label className="mt-3.5 block space-y-1.5">
          <span className="text-xs font-medium text-black/70">
            New value{" "}
            <span className="font-mono text-[10px] text-black/40">
              leave empty to keep
            </span>
          </span>
          <PasswordInput
            name="value"
            variant="admin"
            revealNoun="value"
            autoComplete="off"
            spellCheck={false}
            className="h-9 font-mono text-xs"
          />
        </label>

        <label className="mt-3.5 block space-y-1.5">
          <span className="text-xs font-medium text-black/70">Note</span>
          <Input
            name="note"
            variant="admin"
            defaultValue={note ?? ""}
            className="h-9 text-sm"
          />
        </label>

        <Problem state={state} />
        <Footer
          pending={pending}
          submit="Save"
          onClose={onClose}
          icon={<Check className="size-4" />}
        />
      </form>
    </Modal>
  );
}

